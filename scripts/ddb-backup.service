[Unit]
Description=DDB SQLite snapshot + optional offsite push
Documentation=https://github.com/zerotonin/drosodb
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
EnvironmentFile=-/etc/ddb/backup.env
ExecStart=/usr/local/sbin/ddb-backup
Nice=10
IOSchedulingClass=idle
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# /srv/ddb is the source-DB directory. It must be writable even for
# a read-only backup because WAL-mode SQLite touches -wal/-shm files
# alongside the DB when the writer (the GUI) is active. This still
# implicitly covers /srv/ddb/backups (the snapshot destination).
ReadWritePaths=/srv/ddb
NoNewPrivileges=true
